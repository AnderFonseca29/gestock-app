# ============================================
# GESTOCK - VARIABLES DE ENTORNO (BACKEND)
# Copia este archivo a ".env" y ajusta tus valores.
# ============================================

# Puerto en el que escuchará la API
PORT=3000

# Cadena de conexión a PostgreSQL (base de datos: Gestock_db)
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/Gestock_db
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/Gestock_db

# Secreto para firmar los tokens JWT (cámbialo en producción)
JWT_SECRET=CAMBIAR_ESTA_CLAVE_POR_UNA_LARGA_Y_SEGURA

# Tiempo de expiración del token (8h, 1d, 30m, etc.)
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (frontend Angular)
FRONTEND_URL=http://localhost:4200

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ============================================
# CORREO SMTP (funcionalidad de notificaciones)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu_password_o_app_password
# SMTP_FROM=GESTOCK <no-reply@tu-dominio.com>

# ============================================
# SMS (recuperación de contraseña por teléfono)
# La recuperación se hace con el teléfono móvil registrado del usuario.
# Se envía el código a través de la API REST de Twilio:
#   https://www.twilio.com/console (Account SID y Auth Token)
#   TWILIO_FROM_NUMBER = número Twilio que envía (formato E.164, ej. +15017122661),
#                        o 'whatsapp:+57...' para enviar por WhatsApp.
# Si no se configura, en desarrollo el código se muestra en pantalla y en
# la consola del backend para poder usar el flujo (modo demo).
# ============================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
# TWILIO_FROM_NUMBER=+15017122661
# TWILIO_COUNTRY_CODE=57